    "version": "0.2.0",
    "configurations": [
        
    
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "args": [
                "--gpu", "1",
                "--cfg", "MultiView/ASV2021_LA",
                "-v", "0",
                // "-m","test",
                // "-ckpt",""
            ],
            "justMyCode": false,
            "console": "integratedTerminal"
        }
    ]
}